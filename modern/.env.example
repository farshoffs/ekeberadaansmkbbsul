# Google Sheet database
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Copy EK_PASSWORD_PEPPER from Apps Script Script Properties for existing PIN compatibility.
EK_PASSWORD_PEPPER=

# New web session secret. Use at least 32 random bytes.
EK_WEB_SESSION_SECRET=

# Optional: set this equal to old EK_SESSION_SECRET if you want new trusted-device hashes
# to use the same key family as the old Apps Script deployment.
EK_TRUSTED_DEVICE_SECRET=
