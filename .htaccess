DirectoryIndex index.php
Options -Indexes

# PHP reads these local files directly, but visitors should use index.php.
<FilesMatch "^(?:Code\.gs|Index\.html|Logo\.html|Scripts\.html|Styles\.html|appscript\.json|README\.md|.*\.(?:sql|log|env|bak))$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
